{
  "name": "gitdeck",
  "version": "0.0.0",
  "private": true,
  "description": "GitDeck - desktop Git client for GitHub and GitLab",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "audit:secrets": "gitleaks detect --redact --verbose"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45",
    "electron-vite": "^6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "main": "./out/main/index.js"
}
